# Example environment configuration
#
# There are three env files, selected by APP_ENV (default "localhost") for
# dev builds, and by the Cargo release profile for production builds:
#   .env.local        - full local stack (localhost backend). Default: `npm run tauri:local`
#   .env.development  - shared remote backend. Used by: `npm run tauri:dev`
#   .env.production   - production release build (`tauri build`)
#
# Note: the mode value used to select these is "localhost", not "local" -
# Vite 5 rejects "local" as a --mode value outright (it collides with the
# reserved ".local" env-file suffix). ".env.local" is still the right
# filename regardless of mode name - Vite loads it unconditionally for any
# non-"test" mode.
#
# Copy this file to one of the above and update the values.

# Development Mode (optional)
# Set to 'true' to skip authentication and auto-login with a demo user
# Useful for local development without setting up Supabase
VITE_DEV_MODE=false

# gRPC server URL
GRPC_SERVER=http://localhost:50051

# REST API base URL (used by the frontend's ApiClient)
# In .env.production this MUST point at the public production API endpoint -
# the production build fails if it's unset.
VITE_API_BASE_URL=http://localhost:8080/site

# Supabase Configuration (required if VITE_DEV_MODE is false)
# src-tauri/src/auth.rs reads SUPABASE_URL and SUPABASE_ANON_KEY at compile
# time, so the Rust crate does not build without them. The values below point
# at a local Supabase CLI stack (`supabase start`); the key is the fixed,
# publicly documented demo key the CLI generates for every local stack, not a
# secret. For a hosted project, use its URL and anon key from the dashboard.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
